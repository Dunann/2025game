# Local development uses a free, disk-persisted PostgreSQL engine automatically.
# No database account, Docker installation, or subscription is required.
PORT=3001
HOST=127.0.0.1
PGLITE_DATA_DIR=./.data/postgres

# Future hosted deployment: set NODE_ENV=production and supply a server-only URL.
# DATABASE_URL=postgresql://user:password@host:5432/2025game
# ALLOWED_ORIGINS=https://your-game.example
# TRUST_PROXY=1
